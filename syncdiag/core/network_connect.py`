"""
Módulo de Gerenciamento e Conexão de Rede Remota (SMB sobre Tailscale/LAN).
Responsável por testes de porta 445, injeção de credenciais (cmdkey),
mapeamento de drives (net use) e abertura no Windows Explorer.
"""
from __future__ import annotations

import os
import re
import socket
import subprocess
from typing import Dict, List, Optional, Tuple


def probe_smb_port(host: str, port: int = 445, timeout: float = 2.0) -> bool:
    """Verifica se o host remoto está ouvindo na porta SMB sem congelar a sessão."""
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except (socket.timeout, ConnectionRefusedError, OSError):
        return False


def get_tailscale_peers() -> List[Dict[str, str]]:
    """
    Recupera máquinas da rede Tailscale via comando nativo CLI.
    Retorna lista com hostname, ip e status online.
    """
    try:
        proc = subprocess.run(
            ["tailscale", "status"],
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="replace",
            timeout=5,
        )
        if proc.returncode != 0:
            return []
    except Exception:
        return []

    peers = []
    for line in proc.stdout.splitlines():
        parts = line.split()
        if len(parts) >= 4:
            ip, name = parts[0], parts[1]
            status = "offline" if "offline" in line else "active"
            peers.append({"ip": ip, "name": name, "status": status})
    return peers


def register_credentials(target: str, user: str, password: Optional[str] = None) -> bool:
    """
    Persiste credenciais no Windows Credential Manager via cmdkey.
    Elimina caixas de diálogo pop-up repetitivas ao acessar UNC.
    """
    cmd = ["cmdkey", f"/add:{target}", f"/user:{user}"]
    if password:
        cmd.append(f"/pass:{password}")

    proc = subprocess.run(cmd, capture_output=True, text=True, shell=True)
    return proc.returncode == 0


def mount_network_drive(
    unc_path: str,
    drive_letter: Optional[str] = None,
    user: Optional[str] = None,
    password: Optional[str] = None,
    persistent: bool = True,
) -> Tuple[bool, str]:
    """
    Mapeia uma pasta compartilhada para uma letra de unidade (ex: Z:)
    ou conecta uma sessão autenticada persistente.
    """
    target = drive_letter if drive_letter else unc_path
    cmd = ["net", "use", target, unc_path]

    if password and user:
        cmd.append(password)
        cmd.append(f"/USER:{user}")
    elif user:
        cmd.append(f"/USER:{user}")

    cmd.append(f"/PERSISTENT:{'YES' if persistent else 'NO'}")

    proc = subprocess.run(
        cmd,
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
        shell=True,
    )

    if proc.returncode == 0:
        return True, f"Compartilhamento '{unc_path}' conectado com sucesso!"
    
    err_msg = proc.stderr.strip() or proc.stdout.strip()
    return False, f"Falha ao conectar via 'net use': {err_msg}"


def unmount_network_drive(target: str) -> Tuple[bool, str]:
    """Desconecta uma unidade mapeada ou sessão UNC."""
    cmd = ["net", "use", target, "/DELETE", "/YES"]
    proc = subprocess.run(
        cmd,
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
        shell=True,
    )
    if proc.returncode == 0:
        return True, f"Alvo '{target}' desconectado com sucesso."
    return False, proc.stderr.strip() or proc.stdout.strip()


def open_in_explorer(target_path: str) -> None:
    """Abre a pasta local ou mapeada no Windows Explorer nativo."""
    os.system(f'explorer.exe "{target_path}"')
