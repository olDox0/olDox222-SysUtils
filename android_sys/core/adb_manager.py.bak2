# -*- coding: utf-8 -*-
# android_sys/core/adb_manager.py
"""
Hermes / Poseidon: Gerenciador de Comunicação ADB e Envio sem Fio (TCP/IP).
Controla conexões, pareamento mDNS/código e instalação remota de APKs via Wi-Fi.
Conformidade: ProDeNov 2.1 e 3.1.4.
"""
from __future__ import annotations
import json
import socket
import subprocess
from pathlib import Path
from typing import List, Optional, Tuple
from android_sys.core.installer import get_binary_paths

PROJECT_ROOT = Path(__file__).resolve().parents[2]
CONFIG_FILE = PROJECT_ROOT / "data" / "android_config.json"

def save_last_ip(ip: str):
    CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    cfg = load_config()
    cfg["last_ip"] = ip
    CONFIG_FILE.write_text(json.dumps(cfg, indent=2), encoding="utf-8")

def save_last_endpoint(ip: str, port: str | None = None):
    CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    cfg = load_config()
    cfg["last_ip"] = ip
    if port:
        cfg["last_port"] = port
    CONFIG_FILE.write_text(json.dumps(cfg, indent=2), encoding="utf-8")

def load_config() -> dict:
    if CONFIG_FILE.exists():
        try: return json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
        except: pass
    return {}

def run_adb(args: List[str]) -> subprocess.CompletedProcess:
    adb_bin = get_binary_paths()["adb"]
    cmd = [str(adb_bin)] + args
    return subprocess.run(cmd, capture_output=True, text=True, encoding="utf-8", errors="replace")

def pair_device(ip_port: str, code: str) -> Tuple[bool, str]:
    """Pareia com o celular usando a porta efêmera e o código de 6 dígitos."""
    res = run_adb(["pair", ip_port, code])
    out = res.stdout.strip() or res.stderr.strip()
    success = "successfully paired" in out.lower() or res.returncode == 0
    if success and ":" in ip_port:
        save_last_ip(ip_port.split(":")[0])
    return success, out

def connect_device(target: str) -> Tuple[bool, str]:
    cfg = load_config()
    last_ip = cfg.get("last_ip", "192.168.18.105")
    last_port = cfg.get("last_port", "5555")

    target = target.strip()

    # Validação amigável contra código de pareamento de 6 dígitos
    if target.isdigit() and len(target) == 6:
        return False, f"'{target}' tem 6 dígitos (código de pareamento). Para parear, use: sysutils android pair <IP:PORTA> {target}"

    if target.isdigit():
        target = f"{last_ip}:{target}"
    elif target.startswith(":"):
        target = f"{last_ip}{target}"
    elif ":" not in target:
        target = f"{target}:{last_port}"

    res = run_adb(["connect", target])
    out = res.stdout.strip() or res.stderr.strip()
    success = "connected to" in out.lower()
    if success:
        parts = target.split(":")
        save_last_endpoint(parts[0], parts[1] if len(parts) > 1 else None)
    return success, out

def get_connected_devices() -> List[str]:
    """Retorna os dispositivos Android conectados e ativos."""
    res = run_adb(["devices"])
    devices = []
    for line in res.stdout.splitlines()[1:]:
        parts = line.strip().split()
        if len(parts) >= 2 and parts[1] == "device":
            devices.append(parts[0])
    return devices

def install_apk(device_target: str, apk_path: Path) -> Tuple[bool, str]:
    """Envia e instala um arquivo APK diretamente no celular pelo ar (Wi-Fi)."""
    if not apk_path.exists():
        return False, f"Arquivo não encontrado: {apk_path}"

    # Executa o adb install com flag -r (reinstall preservando dados)
    res = run_adb(["-s", device_target, "install", "-r", str(apk_path.resolve())])
    out = res.stdout.strip() or res.stderr.strip()
    success = "success" in out.lower()
    return success, out

def scan_and_auto_connect(ip: str | None = None) -> Tuple[bool, str]:
    """Varre as portas dinâmicas do Android na rede Wi-Fi e conecta sozinho."""
    target_ip = ip or load_config().get("last_ip", "192.168.18.105")
    if not target_ip:
        return False, "Nenhum IP registrado. Conecte ao menos uma vez informando IP:porta."

    print(f"[*] Varrendo portas ativas no celular ({target_ip})...")
    candidate_ports = []
    for port in range(35000, 45001):
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(0.015)
        if s.connect_ex((target_ip, port)) == 0:
            candidate_ports.append(port)
        s.close()
        if len(candidate_ports) >= 2:
            break

    if not candidate_ports:
        return False, f"Nenhuma porta de depuração aberta detectada em {target_ip}."

    for p in candidate_ports:
        ok, msg = connect_device(f"{target_ip}:{p}")
        if ok:
            return True, f"Conectado com sucesso em {target_ip}:{p}!"

    return False, "Portas localizadas, mas o celular recusou a conexão."

# ─────────────────────────────────────────────────────────────────────
# Audio Focus helpers (RIT-A / RIT-B)
# ─────────────────────────────────────────────────────────────────────

def get_appop(
    device_target: str,
    package: str,
    op: str,
) -> Tuple[bool, str]:
    """
    Executa 'adb -s <target> shell appops get <pkg> <op>'.
    Retorna (sucesso, valor_atual).
    Saída típica: 'TAKE_AUDIO_FOCUS: ignore'
    """
    res = run_adb(["-s", device_target, "shell", "appops", "get", package, op])
    out = (res.stdout.strip() or res.stderr.strip())
    success = res.returncode == 0
    return success, out


def dumpsys_audio(
    device_target: str,
) -> Tuple[bool, str]:
    """
    Executa 'adb -s <target> shell dumpsys audio'.
    Retorna (sucesso, texto_completo).
    """
    res = run_adb(["-s", device_target, "shell", "dumpsys", "audio"])
    out = (res.stdout or res.stderr or "")
    success = res.returncode == 0 and len(out) > 100
    return success, out


def list_packages_matching(
    device_target: str,
    needle: str,
) -> List[str]:
    """
    Lista pacotes instalados cujo nome contém 'needle' (case-insensitive).
    Útil para o usuário descobrir o nome exato de um app de música.
    """
    res = run_adb(["-s", device_target, "shell", "pm", "list", "packages"])
    if res.returncode != 0:
        return []
    needle_lc = needle.lower()
    matches: List[str] = []
    for line in res.stdout.splitlines():
        line = line.strip()
        if not line.startswith("package:"):
            continue
        pkg = line[len("package:"):].strip()
        if needle_lc in pkg.lower():
            matches.append(pkg)
    return sorted(matches)

def set_appop(
    device_target: str,
    package: str,
    op: str,
    mode: str,
) -> Tuple[bool, str]:
    """
    Executa 'adb -s <target> shell appops set <pkg> <op> <mode>'.
    Retorna (sucesso, saída_bruta).
    """
    res = run_adb(["-s", device_target, "shell", "appops", "set", package, op, mode])
    out = (res.stdout.strip() or res.stderr.strip())
    success = res.returncode == 0 and "error" not in out.lower()
    return success, out
